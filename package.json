{
  "name": "daysplit",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaifArfan/daysplit.git"
  },
  "description": "Browser extension that tracks time per website and splits it into work, entertainment and waste.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --zip",
    "icons": "node scripts/icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "lint:firefox": "npx --yes web-ext lint --source-dir dist/firefox"
  },
  "engines": {
    "node": ">=22"
  }
}
